generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  member
}

enum TaskStatus {
  Todo
  InProgress
  InReview
  Done
}

enum TaskPriority {
  Low
  Medium
  High
  Urgent
}

/// Local account. Usernames and emails are stored lower-cased so lookups are
/// case-insensitive. Users are deactivated rather than deleted, so their
/// tasks, comments and uploads keep a valid author.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(64)
  email              String?   @unique @db.VarChar(254)
  name               String    @db.VarChar(120)
  passwordHash       String    @db.VarChar(255)
  role               UserRole  @default(member)
  isActive           Boolean   @default(true)
  /// Set when an admin creates the account or resets the password; the user
  /// must choose their own password before using the app.
  mustChangePassword Boolean   @default(false)
  /// Bumped on password change/reset and deactivation; sessions carrying an
  /// older value are rejected.
  sessionVersion     Int       @default(0)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  projectsOwned  Project[]
  memberships    ProjectMember[]
  tasksCreated   Task[]           @relation("TaskCreator")
  tasksAssigned  Task[]           @relation("TaskAssignee")
  comments       TaskComment[]
  attachments    TaskAttachment[]

  @@map("users")
}

/// Only members (and admins) can see a project and its tasks.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(2000)
  /// Archived projects are read-only and hidden from the sidebar.
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId     String   @db.Uuid

  owner   User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members ProjectMember[]
  tasks   Task[]

  @@index([ownerId])
  @@map("projects")
}

/// The owner always has a membership row too.
model ProjectMember {
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id              String           @id @default(uuid()) @db.Uuid
  title           String           @db.VarChar(200)
  descriptionHtml String           @db.Text
  /// Plain-text copy of the description, kept in sync on save, for search.
  descriptionText String           @default("") @db.Text
  status          TaskStatus       @default(Todo)
  priority        TaskPriority     @default(Medium)
  /// Calendar date only (Muscat time); no time of day.
  dueDate         DateTime?        @db.Date
  /// Checklist items in the description, kept in sync on save.
  checklistTotal  Int              @default(0)
  checklistDone   Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projectId       String           @db.Uuid
  createdById     String           @db.Uuid
  /// Must be a member of the project; cleared when they leave it.
  assigneeId      String?          @db.Uuid
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee        User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  attachments     TaskAttachment[]
  comments        TaskComment[]

  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([assigneeId, status, dueDate])
  @@index([createdAt(sort: Desc)])
  @@index([createdById])
  @@map("tasks")
}

model TaskAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid
  fileName     String   @db.VarChar(255)
  contentType  String   @db.VarChar(100)
  sizeBytes    Int
  storageKey   String   @db.VarChar(512)
  uploadedAt   DateTime @default(now())
  uploadedById String   @db.Uuid

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@map("task_attachments")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String   @db.Uuid

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_comments")
}
