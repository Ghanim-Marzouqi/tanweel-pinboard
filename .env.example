# Copy to `.env` and fill in the blanks. Used by both `docker compose` and
# `npm run dev` (Compose overrides the hostnames inside the app container).

# --- Database ------------------------------------------------------------
POSTGRES_USER=pinboard
# Use URL-safe characters only (letters, digits, - _ .); it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=pinboard
# Only used by `npm run dev` / prisma CLI on the host.
DATABASE_URL=postgresql://pinboard:CHANGE_ME@localhost:5432/pinboard?schema=public

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app. Production: https://pinboard.tanweel.om
AUTH_URL=http://localhost:3000

# First admin, created on container start only while the users table is empty.
# Remove ADMIN_PASSWORD from .env once you have signed in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_EMAIL=

# --- File storage ------------------------------------------------------
# Folder for uploaded attachments. Docker uses the `uploads` volume
# (/app/storage); locally it defaults to ./storage.
# UPLOADS_DIR=storage
