# Copy to `.env` and fill in the blanks. Used by both `docker compose` and
# `npm run dev` (Compose overrides the hostnames inside the app container).

# --- Database ------------------------------------------------------------
POSTGRES_USER=pinboard
# Use URL-safe characters only (letters, digits, - _ .); it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=pinboard
# Only used by `npm run dev` / prisma CLI on the host.
DATABASE_URL=postgresql://pinboard:CHANGE_ME@localhost:5432/pinboard?schema=public

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app. Production: https://pinboard.tanweel.om
AUTH_URL=http://localhost:3000

# First admin, created on container start only while the users table is empty.
# Remove ADMIN_PASSWORD from .env once you have signed in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_EMAIL=

# --- File storage ------------------------------------------------------
# Folder for uploaded attachments. Docker uses the `uploads` volume
# (/app/storage); locally it defaults to ./storage.
# UPLOADS_DIR=storage

# --- Email ---------------------------------------------------------------
# Without SMTP_HOST, emails are written as files to MAIL_CAPTURE_DIR (.mail)
# instead of being sent. For local testing run Mailpit
# (docker compose --profile dev up -d mail) and use SMTP_HOST=localhost,
# SMTP_PORT=1025; its inbox is at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave false for 587/STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Pinboard <no-reply@tanweel.om>
# Morning summary hour (Muscat time, Sunday–Thursday). DAILY_DIGEST=off disables it.
DAILY_DIGEST_HOUR=7
