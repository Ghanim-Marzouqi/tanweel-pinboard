{
  "name": "pinboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "user:create": "node scripts/create-user.mjs",
    "test:e2e": "playwright test",
    "check": "sh scripts/check.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.1",
    "@hookform/resolvers": "^6.0.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/extension-list": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "sharp": true,
    "unrs-resolver": true,
    "@swc/core": true,
    "@parcel/watcher": true,
    "fsevents": true
  },
  "engines": {
    "node": ">=26"
  }
}
